# Local Devnet ONLY. Do not use real funds.
MIDNIGHT_NETWORK=local
MIDNIGHT_PROOF_SERVER=http://127.0.0.1:6300
PRIVATE_STATE_PASSWORD=Replace-With-A-Strong-Local-Secret9!
# Copy the actual deployment address from artifacts/local-e2e.json after npm run test:local.
VAULT_ADDRESS=
PORT=8787
GATEWAY_DB=.private-states/gateway.db
AI_ADAPTER=mock
# Set AI_ADAPTER=provider for real inference with a chat-completions-compatible provider.
LLM_URL=
LLM_API_KEY=
LLM_MODEL=
# Explicit opt-in for PUBLIC TEST networks; never mainnet.
ALLOW_PUBLIC_TEST_DEPLOY=no

# Genuine terminal inference via OpenCode + local Ollama (no paid API key).
# Run ai:up, ai:gpu (keep running), ai:coder:pull and ai:coder:configure.
# Then set AI_ADAPTER=opencode-compact for compiler-validated Compact generation.
OPENCODE_MODEL=local-demo/shadow-compact-coder:7b
OPENCODE_PROFILE=config/opencode-local.json
OPENCODE_SKILL=.opencode/skills/midnight-compact/SKILL.md
# AI_ADAPTER=opencode-compact enables up to three compiler-guided drafts per execution; failed executions reuse the paid receipt.

# Optional local browser terminal. Defaults to the latest successful demo's credit directory.
TERMINAL_PORT=8790
# TERMINAL_CREDIT_DIR=.private-states/demo-TIMESTAMP
