# Copy to the gitignored .env.prepaid.preview; chmod 600 that file.
# Existing .env.preview supplies the Midnight seed and private-state password.
MIDNIGHT_NETWORK=preview
SEPOLIA_RPC_URL=https://YOUR_SEPOLIA_RPC
EVM_RELAY_PRIVATE_KEY=
# Enable only when ready to submit valueless public-test transactions.
ALLOW_PUBLIC_TEST_DEPLOY=no
